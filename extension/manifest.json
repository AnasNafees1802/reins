{
  "manifest_version": 3,
  "name": "Reins",
  "version": "2.0.0",
  "description": "Lets your local coding agent drive this browser with your existing sessions.",
  "key": "",
  "minimum_chrome_version": "125",
  "permissions": ["debugger", "tabs", "tabGroups", "alarms", "storage"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Reins: click to pause or resume agent control" }
}
